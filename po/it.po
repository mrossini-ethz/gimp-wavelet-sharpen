msgstr "Affliatura tramite wavelet"

#: src/plugin.c:81
msgid "_Wavelet sharpen ..."
msgstr "Affilatura tramite _wavelet..."

#: src/plugin.c:85 src/plugin.c:86
msgid "Sharpens the image using wavelets."
msgstr "Affila l'immagine usando le wavelet."

